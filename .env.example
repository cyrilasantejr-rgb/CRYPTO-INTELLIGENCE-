# Copy this file to .env and fill in real values. Never commit .env.

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=crypto-intelligence

# --- Local dev object storage (MinIO, S3-compatible) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Databases ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_intelligence
POSTGRES_USER=
POSTGRES_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Data source vendors (Phase 1+) ---
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
CRYPTOPANIC_API_KEY=
LUNARCRUSH_API_KEY=

# --- App ---
ENV=development
LOG_LEVEL=INFO
